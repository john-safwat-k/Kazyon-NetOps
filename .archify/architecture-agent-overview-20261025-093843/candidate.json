    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "Branch reports an outage → ticket opens in DIAGNOSING",
        "Dual-ping + traceroute decide: FULL_OUTAGE or 4G-only → ESCALATED_TO_ISP",
        "ISP says resolved → VERIFYING → re-test; IP1 + IP2 up → CLOSED"
      ]
    },
    {
      "dot": "amber",
      "title": "Other outcomes",
      "items": [
        "IP1 up / IP2 down → INTERNAL_LAN_ISSUE, Regional IT notified",
        "Re-test fails → reopen ESCALATED_TO_ISP and keep chasing",
        "Scheduler chases overdue ISP tickets on their follow-up timer"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM guardrails",
      "items": [
        "Gemma only returns guided-JSON intent + entities",
        "Python workflow + state machine make every transition",
        "vLLM down → retry queue, then NEEDS_HUMAN_REVIEW"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety stops",
      "items": [
        "Global kill switch or per-ticket Pause AI skips autonomous actions",
