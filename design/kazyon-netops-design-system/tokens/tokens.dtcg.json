  "spacing": {
    "space-1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Icon-to-label gap, pill padding."
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Inside badges and compact rows."
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Ticket card padding, list row padding."
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Card padding, grid gutter."
    },
    "space-6": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Page padding, gap between dashboard sections."
    },
    "space-8": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Large section spacing, login form."
    }
  },
  "radius": {
    "radius-sm": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Badges, inputs, small buttons."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Buttons, ticket cards, nav rows."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Dashboard cards, panels, drawers."
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Status pills, SLA timers, avatars."
    }
  },
  "shadow": {
    "light": {
      "shadow-card": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(31,26,23,0.06)"
      },
      "shadow-raised": {
        "$type": "shadow",
        "$value": "0 8px 24px rgba(31,26,23,0.12)"
      }
    },
    "dark": {
      "shadow-card": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(0,0,0,0.4)"
      },
      "shadow-raised": {
        "$type": "shadow",
        "$value": "0 8px 24px rgba(0,0,0,0.5)"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "40px",
        "lineHeight": "44px",
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      },
      "$description": "Login hero and empty-state headlines."
    },
    "kpi": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "32px",
        "lineHeight": "36px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "$description": "KPI card numbers. Tabular figures."
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "24px",
        "lineHeight": "32px",
        "fontWeight": 700
      },
      "$description": "Page title, one per page."
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "18px",
        "lineHeight": "26px",
        "fontWeight": 600
      },
      "$description": "Card and panel titles."
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "15px",
        "lineHeight": "22px",
        "fontWeight": 600
      },
      "$description": "Ticket card titles, drawer section heads."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 400
      },
      "$description": "Default UI text."
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 500
      },
      "$description": "Metadata, table secondary lines, axis labels."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "11px",
        "lineHeight": "16px",
