# ==============================================================================
# IT Network Support AI Agent & Ticketing Harness — Base / Local Configuration
# ==============================================================================
# For remote server deployment on 10.100.109.9, see:
#   - .env.dev.example  (DEV stack:  it-net-*-dev,  App :8085, PG :5435, Redis :6385)
#   - .env.prod.example (PROD stack: it-net-*-prod, App :8084, PG :5434, Redis :6384)
# ==============================================================================

# --- Environment & Container Identity ---
APP_NAME="IT Network Support AI Agent"
APP_ENV=development
ENV_SLUG=dev
COMPOSE_PROJECT_NAME=it-net-support-dev
IMAGE_NAME=it-net-support-agent
IMAGE_TAG=dev
APP_PORT=8085
DEBUG=true
LOG_LEVEL=INFO

# --- Security & Cryptography ---
SECRET_KEY=it-net-default-insecure-secret-key-replace-in-production
ENCRYPTION_KEY=it-net-default-crypto-key-32-ch!

# --- Initial Super Admin Bootstrap ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=it-net-admin-change-me
ADMIN_EMAIL=admin@kazyon.com
ADMIN_DISPLAY_NAME="Network Support Super Admin"
AUTH_TOKEN_EXPIRE_HOURS=24

# --- Database (Local Dev defaults to SQLite; Docker Dev/Prod override to Postgres) ---
DATABASE_URL=sqlite+aiosqlite:///./data/it_net_support.db
SYNC_DATABASE_URL=sqlite:///./data/it_net_support.db

# --- PostgreSQL 16 Container Settings ---
POSTGRES_DB=it_net_support_dev
POSTGRES_USER=it_net_user
POSTGRES_PASSWORD=change_me_postgres_dev_password
POSTGRES_PORT=5435
POSTGRES_BIND=0.0.0.0

# --- SQLAlchemy Connection Pool (Postgres) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SEC=1800

# --- Redis 7 Container Settings (Cache, Distributed Locks & Task Broker) ---
REDIS_PASSWORD=change_me_redis_dev_password
REDIS_URL=redis://:change_me_redis_dev_password@localhost:6385/0
REDIS_PORT=6385
REDIS_BIND=0.0.0.0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SEC=120

# --- Self-Hosted vLLM AI Server (Gemma 4 26B A4B NVFP4 on 10.100.109.9:8002) ---
VLLM_BASE_URL=http://10.100.109.9:8002
VLLM_API_KEY=
DEFAULT_WORKER_MODEL=google/gemma-4-26B-A4B-it
DEFAULT_ROUTER_MODEL=google/gemma-4-26B-A4B-it
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.2
VLLM_POOL_MAX_CONNECTIONS=32
VLLM_POOL_MAX_KEEPALIVE=16
VLLM_POOL_KEEPALIVE_EXPIRY_SEC=300
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SEC=30.0
# Emails deferred while vLLM is down are re-ingested from this queue after the backoff
LLM_RETRY_QUEUE_DIR=./data/imports/llm_retry
LLM_RETRY_BACKOFF_SEC=300

# --- Inbound / Outbound Email Engine (Branch & ISP Communication) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SEC=60

# Outbound SMTP host, port, security mode (starttls / ssl / none), sender address and the
# "Send real email" switch are set on Page 12 (AI Agent, Mailbox & SLA Settings).
# Only the optional login lives here; leave both empty for an internal relay without auth.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Inbound SMTP listener (company mail server -> agent) ---
# Receive-only SMTP on SMTP_LISTENER_PORT inside the container. Accepted mail goes to
# data/imports/inbox/ and is ingested by the poller. No AUTH/TLS: lock it to your mail server.
SMTP_LISTENER_ENABLED=false
SMTP_LISTENER_HOST=0.0.0.0
SMTP_LISTENER_PORT=2525
# Host port published by docker-compose (deploy.sh pins dev=2525, prod=2524)
SMTP_LISTENER_PUBLISH_PORT=2525
# Comma-separated IPs/CIDRs of the forwarding mail server(s); 0.0.0.0/0 is refused in production
SMTP_LISTENER_ALLOWED_CLIENTS=127.0.0.1/32
# Comma-separated accepted recipients; empty = the Page 12 sender address
SMTP_LISTENER_ALLOWED_RECIPIENTS=
SMTP_LISTENER_MAX_MESSAGE_MB=25
SMTP_LISTENER_HOSTNAME=netops-agent.kazyon.local
MAX_OUTBOUND_EMAILS_PER_TICKET_HOUR=6
LOOP_GUARD_FAIL_OPEN_FOR_TESTS=false
ATTACHMENTS_DIR=./data/attachments

# --- Troubleshooting Script Executor & ISP Follow-up Scheduler ---
DIAGNOSTIC_MODE=live
DIAGNOSTIC_TIMEOUT_SEC=60
DEFAULT_ISP_FOLLOWUP_INTERVAL_MIN=60
DEFAULT_TIMEZONE=Africa/Cairo

# --- Deployment Defaults (deploy.sh) ---
SERVER_HOST=10.100.109.9
SERVER_USER=kazyon
SERVER_SSH_PORT=22
DEPLOY_NO_BUILD=0

# --- Optional HTTPS TLS ---
HTTPS_CERTFILE=
HTTPS_KEYFILE=
