# ==============================================================================
# IT Network Support AI Agent — PROD Environment Configuration (10.100.109.9)
# ==============================================================================
# Isolated PROD containers on 10.100.109.9:
#   - Compose Project : it-net-support-prod
#   - Remote Dir      : ~/it-network-support-agent-prod
#   - App Container   : it-net-agent-prod    (Port 8084 -> 8000)
#   - DB Container    : it-net-postgres-prod (Port 5434 -> 5432, Volume: pgdata_prod)
#   - Redis Container : it-net-redis-prod    (Port 6384 -> 6379, Volume: redisdata_prod)
# ==============================================================================

APP_NAME="IT Network Support AI Agent"
APP_ENV=production
ENV_SLUG=prod
COMPOSE_PROJECT_NAME=it-net-support-prod
IMAGE_NAME=it-net-support-agent-prod
IMAGE_TAG=latest
APP_PORT=8084
DEBUG=false
LOG_LEVEL=INFO

# --- Security & Cryptography (MUST BE REPLACED ON SERVER BEFORE STARTING PROD) ---
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_IN_PROD
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY_IN_PROD

# --- Initial Super Admin Bootstrap (MUST BE REPLACED ON SERVER) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_IN_PROD
ADMIN_EMAIL=admin@kazyon.com
ADMIN_DISPLAY_NAME="Network Support Super Admin"
AUTH_TOKEN_EXPIRE_HOURS=24

# --- PostgreSQL 16 (PROD Container `postgres` on compose network) ---
POSTGRES_DB=it_net_support_prod
POSTGRES_USER=it_net_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PG_PASSWORD_IN_PROD
POSTGRES_PORT=5434
POSTGRES_BIND=0.0.0.0
DATABASE_URL=postgresql+psycopg://it_net_prod:REPLACE_WITH_STRONG_PG_PASSWORD_IN_PROD@postgres:5432/it_net_support_prod
SYNC_DATABASE_URL=postgresql+psycopg://it_net_prod:REPLACE_WITH_STRONG_PG_PASSWORD_IN_PROD@postgres:5432/it_net_support_prod

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SEC=1800

# --- Redis 7 (PROD Container `redis` on compose network) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_IN_PROD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD_IN_PROD@redis:6379/0
REDIS_PORT=6384
REDIS_BIND=0.0.0.0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SEC=120

# --- Self-Hosted vLLM AI Server (Gemma 4 26B A4B NVFP4 on 10.100.109.9:8002) ---
VLLM_BASE_URL=http://10.100.109.9:8002
VLLM_API_KEY=
DEFAULT_WORKER_MODEL=google/gemma-4-26B-A4B-it
DEFAULT_ROUTER_MODEL=google/gemma-4-26B-A4B-it
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.2
VLLM_POOL_MAX_CONNECTIONS=32
VLLM_POOL_MAX_KEEPALIVE=16
VLLM_POOL_KEEPALIVE_EXPIRY_SEC=300
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SEC=30.0
# Emails deferred while vLLM is down are re-ingested from this queue after the backoff
LLM_RETRY_QUEUE_DIR=/app/data/imports/llm_retry
LLM_RETRY_BACKOFF_SEC=300

# --- Email Engine (PROD SMTP Mailbox) ---
# Outbound SMTP host, port, security mode (starttls / ssl / none), sender address and the
# "Send real email" switch are set on Page 12 (AI Agent, Mailbox & SLA Settings).
SMTP_USERNAME=noc@kazyon.com
SMTP_PASSWORD=

# --- Inbound SMTP listener (company mail server -> agent) ---
# Receive-only SMTP on SMTP_LISTENER_PORT inside the container. Accepted mail goes to
# data/imports/inbox/ and is ingested by the poller. No AUTH/TLS: lock it to your mail server.
SMTP_LISTENER_ENABLED=false
SMTP_LISTENER_HOST=0.0.0.0
SMTP_LISTENER_PORT=2525
# Host port published by docker-compose (deploy.sh pins dev=2525, prod=2524)
SMTP_LISTENER_PUBLISH_PORT=2524
# Comma-separated IPs/CIDRs of the forwarding mail server(s); 0.0.0.0/0 is refused in production
SMTP_LISTENER_ALLOWED_CLIENTS=REPLACE_WITH_MAIL_SERVER_IP
# Comma-separated accepted recipients; empty = the Page 12 sender address
SMTP_LISTENER_ALLOWED_RECIPIENTS=
SMTP_LISTENER_MAX_MESSAGE_MB=25
SMTP_LISTENER_HOSTNAME=netops-agent.kazyon.local
MAX_OUTBOUND_EMAILS_PER_TICKET_HOUR=6
LOOP_GUARD_FAIL_OPEN_FOR_TESTS=false
ATTACHMENTS_DIR=/app/data/attachments

# --- Troubleshooting Script Executor & ISP Follow-up Scheduler ---
DIAGNOSTIC_MODE=live
DIAGNOSTIC_TIMEOUT_SEC=60
DEFAULT_ISP_FOLLOWUP_INTERVAL_MIN=60
DEFAULT_TIMEZONE=Africa/Cairo

# --- Deployment Target ---
SERVER_HOST=10.100.109.9
SERVER_USER=kazyon
REMOTE_DIR=~/it-network-support-agent-prod
SERVER_SSH_PORT=22
DEPLOY_NO_BUILD=0

HTTPS_CERTFILE=
HTTPS_KEYFILE=
